# Meal Prep Market — frontend environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Public — safe to expose to the browser (anon key is RLS-restricted)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1

# Site domain — placeholder until a real domain is registered.
# Referenced in Edge Function secrets (SITE_URL) for email links and
# Stripe redirect URLs, not read directly by the frontend build.
# Current placeholder: mealprepmarket.com.au
